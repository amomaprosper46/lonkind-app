rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function: Checks if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Checks if the token uid matches the target folder parameter
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * PUBLIC/APP SYSTEM ASSETS
     * Anyone can read (e.g., app logos, public landing images). Only admins can update them.
     */
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    /**
     * USER PERSONAL VAULT (Profiles, Uploads, Personal Media)
     * Files are strictly isolated to the authenticated owner.
     */
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }
    
  }
}