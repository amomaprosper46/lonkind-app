
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }

    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      match /friendRequests/{senderId} {
        // userId is the one receiving, senderId is the one sending.
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderId);
        allow create: if request.auth != null && request.auth.uid == senderId;
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /savedPosts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /blockedUsers/{blockedId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /mutedUsers/{mutedId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      // Logged-in users can create posts
      allow create: if request.auth != null;
      // Only the author of the post can update it.
      allow update: if request.auth != null && request.auth.uid == resource.data.author.uid;
      // The author or an admin can delete a post.
      allow delete: if request.auth != null && (request.auth.uid == resource.data.author.uid || isAdmin());

      match /reactions/{reactionId} {
        allow read, write: if request.auth != null;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, list, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Let members join/leave
    }

    match /transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if true; // Let the backend create this
      allow update, delete: if false;
    }
    
    match /payouts/{payoutId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if true; // Let the backend create this
      allow update, delete: if false;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow create: if true; // Let the backend create this
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }
    
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
