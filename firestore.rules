rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         (request.auth.token != null && request.auth.token.email == 'admin@lonkind.com'));
    }

    /* ---------------- USERS ---------------- */

    match /users/{userId} {

      allow get, list: if isSignedIn();

      allow create: if isOwner(userId);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'coins', 'diamonds', 'balance', 'balanceUSD', 'balanceNaira', 'earningsNaira',
          'heldEarningsNaira', 'lifetimeTipsReceived', 'lifetimeTipsGiven',
          'isVerified', 'kycVerified', 'payoutTier', 'isTopCreator', 'role',
          'isProfessional', 'fraudFlagged', 'velocityFlagged', 'createdAt'
        ])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /friends/{friendId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friendRequests/{senderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);

        allow create: if isSignedIn() && request.auth.uid == senderId;

        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }

      match /following/{followingId} {
        allow read, write: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == followerId;
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /mutedUsers/{mutedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /recommendationProfile/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /interactionSignals/{signalId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    /* ---------------- POSTS ---------------- */

    match /posts/{postId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid ||
        // only allow safe engagement counter/reaction updates by non-authors
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'reactions', 'likes', 'likesCount', 'commentsCount', 'sharesCount'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid
      );

      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == reactionId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.author.uid;
      }
    }

    /* ---------------- STORIES ---------------- */

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        request.auth.uid == resource.data.authorUid;
    }

    /* ---------------- REPORTS ---------------- */

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }

    /* ---------------- APPEALS ---------------- */

    match /appeals/{appealId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* ---------------- GROUPS ---------------- */

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    /* ---------------- SPACES ---------------- */

    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.host.uid;

      allow update: if isSignedIn();
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.host.uid;
    }

    /* ---------------- LIVE STREAMS ---------------- */

    match /live_streams/{streamId} {
      // Anyone can see active live streams on home feed
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.hostUid == request.auth.uid ||
        streamId == 'live_' + request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.hostUid == request.auth.uid ||
        streamId == 'live_' + request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'likesCount', 'totalCoins', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.hostUid == request.auth.uid ||
        streamId == 'live_' + request.auth.uid
      );

      // Real-time viewer tracking (supports signed-in users and guest_* WebRTC viewers)
      match /viewers/{viewerId} {
        allow read: if true;
        allow write, delete: if isSignedIn() || viewerId.matches('^guest_[a-zA-Z0-9_]+$');
      }

      // Live chat & gift stream announcements
      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (
          isSignedIn() && (
            resource.data.senderId == request.auth.uid ||
            streamId == 'live_' + request.auth.uid
          )
        );
      }

      // Split-screen co-host guest requests
      match /cohost_requests/{requestId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Top gifters & contributor leaderboard
      match /contributors/{contributorId} {
        allow read: if true;
        allow write: if isAdmin() || (
          isSignedIn() && (
            request.auth.uid == contributorId ||
            streamId == 'live_' + request.auth.uid
          )
        );
      }
    }

    /* ---------------- TRANSACTIONS (FIXED) ---------------- */

    match /transactions/{txId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- PAYOUTS ---------------- */

    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- GIFTS ---------------- */

    match /gifts/{giftId} {
      allow read: if true;

      allow create, update, delete: if false;
    }

    /* ---------------- CONVERSATIONS ---------------- */

    match /conversations/{conversationId} {

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids;

      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        // Read messages
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        // Create a new message
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        // Update for edit by sender or per‑user delete
        allow update: if isSignedIn() && (
          // Sender can edit text and set editedAt, but cannot modify other fields
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.editedAt == request.time &&
            request.resource.data.deletedFor == resource.data.deletedFor &&
            request.resource.data.type == resource.data.type) ||
          // Any participant can add themselves to deletedFor (per‑user delete)
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
            request.resource.data.deletedFor.toSet() == resource.data.get('deletedFor', []).toSet().union([request.auth.uid].toSet()) &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.type == resource.data.type)
        );
        // No hard delete allowed
        // (delete) is implicitly denied by not granting it
      }
    }

    /* ---------------- ADMINS ---------------- */

    match /admins/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'admin@lonkind.com' && request.auth.uid == userId);
    }

    /* ---------------- WALLETS (server-write only) -------------- */

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Admin SDK only — no client writes ever
    }

    /* -------------- PAYOUT REQUESTS (server-write only) -------- */

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      allow create, update, delete: if false; // Admin SDK only
    }

    /* -------------- PAYOUT IDEMPOTENCY (server-write only) ----- */

    match /payoutIdempotency/{keyId} {
      allow read, write: if false; // Admin SDK only — internal dedup store
    }

    /* -------------- WEBHOOK LOGS (server-write only) ----------- */

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    /* -------------- AUDIT LOGS (append-only, admin-read) ------- */

    match /wallet_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only — append-only
    }

    /* ------ DOUBLE-ENTRY LEDGER (append-only, server-write only) ------ */

    match /ledger_journals/{journalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.actorUid == request.auth.uid);
      allow create, update, delete: if false; // Admin SDK ACID Transaction only
    }

    match /ledger_entries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.accountId == request.auth.uid);
      allow create, update, delete: if false; // Admin SDK ACID Transaction only
    }

    match /ledger_idempotency/{keyId} {
      allow read, write: if false; // Admin SDK ACID Transaction only
    }

    /* -------------- TRENDING HASHTAGS (server-write only) ------ */

    match /trending_hashtags/{tagId} {
      allow read: if true; // Publicly readable for trending UI
      allow write: if false; // Cloud Functions only
    }

    /* -------------- PLATFORM SETTINGS (events & gift overrides) ------ */

    match /platform_settings/{docId} {
      allow read: if true; // Publicly readable for live stream events & gift overrides
      allow write: if isAdmin();
    }
  }
}