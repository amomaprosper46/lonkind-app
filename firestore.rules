rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* ---------------- USERS ---------------- */

    match /users/{userId} {

      allow get, list: if isSignedIn();

      allow create: if isOwner(userId);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'diamonds', 'earningsNaira', 'heldEarningsNaira', 'lifetimeTipsReceived', 'lifetimeTipsGiven'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']))
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /friends/{friendId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friendRequests/{senderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);

        allow create: if isSignedIn() && request.auth.uid == senderId;

        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }

      match /following/{followingId} {
        allow read, write: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == followerId;
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /mutedUsers/{mutedId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    /* ---------------- POSTS ---------------- */

    match /posts/{postId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid ||
        // only allow safe system updates (comments/reactions only)
        request.resource.data.keys().hasAny(['comments', 'reactions'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid
      );

      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == reactionId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.author.uid;
      }
    }

    /* ---------------- STORIES ---------------- */

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        request.auth.uid == resource.data.authorUid;
    }

    /* ---------------- REPORTS ---------------- */

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, delete: if isAdmin();
    }

    /* ---------------- GROUPS ---------------- */

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    /* ---------------- SPACES ---------------- */

    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.host.uid;

      allow update: if isSignedIn();
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.host.uid;
    }

    /* ---------------- TRANSACTIONS (FIXED) ---------------- */

    match /transactions/{txId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- PAYOUTS ---------------- */

    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- GIFTS ---------------- */

    match /gifts/{giftId} {
      allow read: if true;

      allow create, update, delete: if false;
    }

    /* ---------------- CONVERSATIONS ---------------- */

    match /conversations/{conversationId} {

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids;

      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        // Create a new message
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        // Update for edit by sender or per‑user delete
        allow update: if isSignedIn() && (
          // Sender can edit text and set editedAt, but cannot modify other fields
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.editedAt == request.time &&
            request.resource.data.deletedFor == resource.data.deletedFor &&
            request.resource.data.type == resource.data.type) ||
          // Any participant can add themselves to deletedFor (per‑user delete)
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
            request.resource.data.deletedFor == resource.data.deletedFor.union([request.auth.uid]) &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.type == resource.data.type)
        );
        // No hard delete allowed
        // (delete) is implicitly denied by not granting it
      }
    }

    /* ---------------- ADMINS ---------------- */

    match /admins/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'admin@lonkind.com' && request.auth.uid == userId);
    }

    /* ---------------- WALLETS (server-write only) -------------- */

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Admin SDK only — no client writes ever
    }

    /* -------------- PAYOUT REQUESTS (server-write only) -------- */

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      allow create, update, delete: if false; // Admin SDK only
    }

    /* -------------- PAYOUT IDEMPOTENCY (server-write only) ----- */

    match /payoutIdempotency/{keyId} {
      allow read, write: if false; // Admin SDK only — internal dedup store
    }

    /* -------------- WEBHOOK LOGS (server-write only) ----------- */

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    /* -------------- AUDIT LOGS (append-only, admin-read) ------- */

    match /wallet_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only — append-only
    }

    /* -------------- TRENDING HASHTAGS (server-write only) ------ */

    match /trending_hashtags/{tagId} {
      allow read: if true; // Publicly readable for trending UI
      allow write: if false; // Cloud Functions only
    }
  }
}