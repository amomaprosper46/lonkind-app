rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ====================================================================== */
    /* GLOBAL SECURITY HELPERS                                                */
    /* ====================================================================== */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reusable Super-Admin (`mow`) helper: checks Firestore `role == "super_admin"` or custom claim `superAdmin == true`
    function isSuperAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin') ||
        (request.auth.token != null && (
          request.auth.token.get('superAdmin', false) == true ||
          request.auth.token.get('role', '') == 'super_admin'
        ))
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    // Financial, role, and trust fields that NO client may ever forge or mutate directly
    function protectedUserKeys() {
      return [
        'walletBalance', 'coins', 'diamonds', 'coinBalance', 'bonusBalance', 'cashableBalance',
        'balance', 'balanceUSD', 'balanceNaira',
        'earningsNaira', 'heldEarningsNaira', 'lifetimeTipsReceived', 'lifetimeTipsGiven',
        'hasMadeFirstPurchase', 'firstPurchaseAt', 'promoBonusCoinsReceived',
        'isAdmin', 'isVerified', 'isOfficialBrand', 'kycVerified', 'payoutTier', 'isTopCreator', 'role',
        'isProfessional', 'fraudFlagged', 'velocityFlagged', 'createdAt'
      ];
    }

    function hasValidInitialWalletState() {
      return !request.resource.data.keys().hasAny([
        'walletBalance', 'bonusBalance', 'cashableBalance',
        'balance', 'balanceUSD', 'balanceNaira', 'earningsNaira',
        'heldEarningsNaira', 'lifetimeTipsReceived', 'lifetimeTipsGiven',
        'hasMadeFirstPurchase', 'firstPurchaseAt', 'promoBonusCoinsReceived',
        'isAdmin', 'isVerified', 'isOfficialBrand', 'kycVerified', 'payoutTier', 'isTopCreator',
        'isProfessional', 'fraudFlagged', 'velocityFlagged'
      ]) &&
      (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
      (!('coinBalance' in request.resource.data) || request.resource.data.coinBalance == 0) &&
      (!('coins' in request.resource.data) || request.resource.data.coins == 0) &&
      (!('diamonds' in request.resource.data) || request.resource.data.diamonds == 0);
    }

    // Enforce 18+ age verification flag and valid @gmail.com email (when email is supplied) on new client signups
    function hasValidAdultAndGmailSignup() {
      return (!('email' in request.resource.data) ||
        (request.resource.data.email is string &&
          request.resource.data.email.lower().matches('^[^\\s@]+@gmail\\.com$'))) &&
        (!('isAdult' in request.resource.data) || request.resource.data.isAdult == true) &&
        (!('age' in request.resource.data) || (request.resource.data.age is number && request.resource.data.age >= 18));
    }

    // Enforce realistic First + Last Name on direct client-side user document creation
    function hasValidRealName() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() >= 5 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.name.matches('^[^0-9\\s]{2,}( [^0-9\\s]{2,})+$');
    }

    // Resolves whether caller is the stream's host (supports both `hostId` and `hostUid`)
    function isStreamHost(streamId) {
      return isSignedIn() && (
        streamId == 'live_' + request.auth.uid ||
        (exists(/databases/$(database)/documents/streams/$(streamId)) && (
          get(/databases/$(database)/documents/streams/$(streamId)).data.get('hostUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/streams/$(streamId)).data.get('hostId', '') == request.auth.uid
        )) ||
        (exists(/databases/$(database)/documents/live_streams/$(streamId)) && (
          get(/databases/$(database)/documents/live_streams/$(streamId)).data.get('hostUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/live_streams/$(streamId)).data.get('hostId', '') == request.auth.uid
        ))
      );
    }

    function getStreamHostId(streamId) {
      return exists(/databases/$(database)/documents/streams/$(streamId))
        ? get(/databases/$(database)/documents/streams/$(streamId)).data.get(
            'hostUid',
            get(/databases/$(database)/documents/streams/$(streamId)).data.get('hostId', '')
          )
        : (exists(/databases/$(database)/documents/live_streams/$(streamId))
            ? get(/databases/$(database)/documents/live_streams/$(streamId)).data.get(
                'hostUid',
                get(/databases/$(database)/documents/live_streams/$(streamId)).data.get('hostId', '')
              )
            : '');
    }

    function isAppointedMod(streamId) {
      return isSignedIn() &&
        getStreamHostId(streamId) != '' &&
        exists(/databases/$(database)/documents/users/$(getStreamHostId(streamId))/moderators/$(request.auth.uid));
    }

    function isRestrictedFromStream(streamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/streams/$(streamId)/restricted_users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/streams/$(streamId)/restricted_users/$(request.auth.uid)).data.type == 'BAN' ||
          get(/databases/$(database)/documents/streams/$(streamId)/restricted_users/$(request.auth.uid)).data.expiresAt > request.time
        );
    }

    /* ====================================================================== */
    /* 1. USERS & WALLETS (`users/{userId}`)                                  */
    /* ====================================================================== */

    match /users/{userId} {
      // Authenticated users can read public profile docs (private vaults live in subcollections)
      allow get, list: if isSignedIn();

      // Prevent minting coins/walletBalance, forging roles, underage/non-Gmail signups, or fake names on signup
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        hasValidInitialWalletState() &&
        hasValidRealName() &&
        hasValidAdultAndGmailSignup()
      );

      // Users may ONLY edit their own non-financial profile/privacy/blockedWords fields
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserKeys())) ||
        // Safe follower counter updates from accepted follows
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
      );

      allow delete: if isOwner(userId) || isAdmin();

      /* Private User Subcollections (Strictly Owner-Only) */
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /mutedUsers/{mutedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /recommendationProfile/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /interactionSignals/{signalId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }

      /* Social Graph & Appointed Live Moderators */
      match /friends/{friendId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /moderators/{modUid} {
        allow read: if true;
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /friendRequests/{senderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
        allow create: if isSignedIn() && request.auth.uid == senderId;
        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /followRequests/{senderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
        allow create: if isSignedIn() && request.auth.uid == senderId;
        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /following/{followingId} {
        allow read, write: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == followerId;
        allow delete: if isSignedIn() && (request.auth.uid == followerId || isOwner(userId));
      }
    }

    /* ====================================================================== */
    /* 2. FOLLOWER REQUESTS & PRIVACY (`follows` & `follower_requests`)       */
    /* ====================================================================== */

    match /follows/{followId} {
      allow read: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );

      // Caller can only create a follow request for themselves
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.status in ['PENDING', 'ACCEPTED'];

      // CRITICAL: ONLY the target creator can approve (ACCEPTED), block (BLOCKED), or change status
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.targetUserId == request.auth.uid &&
         request.resource.data.followerId == resource.data.followerId &&
         request.resource.data.targetUserId == resource.data.targetUserId &&
         request.resource.data.status in ['ACCEPTED', 'BLOCKED', 'PENDING'])
      );

      // Target creator can remove/decline a follower; follower can cancel their own request / unfollow
      allow delete: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /follower_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.status == 'PENDING';

      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.targetUserId == request.auth.uid &&
         request.resource.data.followerId == resource.data.followerId &&
         request.resource.data.targetUserId == resource.data.targetUserId &&
         request.resource.data.status in ['ACCEPTED', 'BLOCKED'])
      );

      allow delete: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );
    }

    /* ====================================================================== */
    /* 3. LIVE STREAMS, CHAT, POLLS, GIFTS, GUESTS & MODERATORS               */
    /* ====================================================================== */

    match /streams/{streamId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('hostUid', '') == request.auth.uid ||
        request.resource.data.get('hostId', '') == request.auth.uid ||
        streamId == 'live_' + request.auth.uid
      );

      // Host controls settings, pinnedMessage, streamGoal definition, and activeGuests.
      // Viewers may only increment `likesCount` (and `streamGoal.currentAmount` for LIKES goals).
      allow update: if isSignedIn() && (
        isAdmin() ||
        isStreamHost(streamId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'streamGoal', 'updatedAt']) &&
          resource.data.streamGoal != null &&
          resource.data.streamGoal.type == 'LIKES' &&
          request.resource.data.streamGoal.type == resource.data.streamGoal.type &&
          request.resource.data.streamGoal.title == resource.data.streamGoal.title &&
          request.resource.data.streamGoal.targetAmount == resource.data.streamGoal.targetAmount &&
          request.resource.data.streamGoal.currentAmount >= resource.data.streamGoal.currentAmount
        )
      );

      allow delete: if isAdmin() || isStreamHost(streamId);

      // Polls: ONLY host creates/deletes; authenticated users can cast exactly ONE vote
      match /polls/{pollId} {
        allow read: if true;
        allow create, delete: if isAdmin() || isStreamHost(streamId);
        allow update: if isAdmin() || isStreamHost(streamId) || (
          isSignedIn() &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voters', 'totalVotes']) &&
          !(request.auth.uid in resource.data.get('voters', {}).keys()) &&
          request.resource.data.voters.diff(resource.data.get('voters', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.totalVotes == resource.data.get('totalVotes', 0) + 1
        );
      }

      // Paid Gifts: Server-side Admin SDK ACID transaction ONLY (`/api/streams/send-gift`)
      match /gifts/{giftId} {
        allow read: if true;
        allow write: if false;
      }

      // Multi-Guest Join Requests
      match /guest_requests/{guestUid} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == guestUid
          && request.resource.data.status == 'PENDING';
        allow update: if isAdmin() || isStreamHost(streamId);
        allow delete: if isAdmin() || isStreamHost(streamId) || (isSignedIn() && request.auth.uid == guestUid);
      }

      // WebRTC Co-Host Signaling
      match /guest_signals/{signalId} {
        allow read, create, delete: if isSignedIn();
      }

      // Live Chat Messages: senderId must match auth UID AND user must not be muted/banned
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !isRestrictedFromStream(streamId);
        allow update, delete: if isAdmin() || isStreamHost(streamId) || isAppointedMod(streamId) || (
          isSignedIn() && resource.data.senderId == request.auth.uid
        );
      }

      // Restricted Users (Muted 10m / Banned): ONLY Host or Appointed Moderators may manage
      match /restricted_users/{restrictedUid} {
        allow read: if isSignedIn() && (
          request.auth.uid == restrictedUid ||
          isStreamHost(streamId) ||
          isAppointedMod(streamId) ||
          isAdmin()
        );
        allow create, update, delete: if isAdmin() || isStreamHost(streamId) || isAppointedMod(streamId);
      }
    }

    match /live_streams/{streamId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('hostUid', '') == request.auth.uid ||
        request.resource.data.get('hostId', '') == request.auth.uid ||
        streamId == 'live_' + request.auth.uid
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        isStreamHost(streamId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'likesCount', 'updatedAt'])
      );

      allow delete: if isAdmin() || isStreamHost(streamId);

      // Real-time WebRTC viewer signaling (supports signed-in users and guest_* viewers)
      match /viewers/{viewerId} {
        allow read: if true;
        allow write, delete: if isSignedIn() || viewerId.matches('^guest_[a-zA-Z0-9_]+$');
      }

      // Live chat announcements: enforce senderId match + mute/ban block + Host/Mod deletion
      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !isRestrictedFromStream(streamId);
        allow update, delete: if isAdmin() || isStreamHost(streamId) || isAppointedMod(streamId) || (
          isSignedIn() && resource.data.senderId == request.auth.uid
        );
      }

      // Legacy co-host requests (scoped strictly to requester or host)
      match /cohost_requests/{requestId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin() || isStreamHost(streamId) || (isSignedIn() && request.auth.uid == requestId);
        allow update: if isAdmin() || isStreamHost(streamId);
      }

      // Top gifters leaderboard (server-side gift API writes via Admin SDK; host/admin may manage)
      match /contributors/{contributorId} {
        allow read: if true;
        allow write: if isAdmin() || isStreamHost(streamId);
      }
    }

    /* ====================================================================== */
    /* SCHEDULED STREAMS & REMIND ME                                          */
    /* ====================================================================== */

    match /scheduled_streams/{scheduleId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.hostId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.hostId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscribersCount', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.hostId == request.auth.uid);

      match /reminders/{reminderUid} {
        // Protect FCM push tokens from unauthorized reads
        allow read: if isSignedIn() && (
          request.auth.uid == reminderUid ||
          isAdmin() ||
          get(/databases/$(database)/documents/scheduled_streams/$(scheduleId)).data.hostId == request.auth.uid
        );
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == reminderUid ||
          isAdmin()
        );
      }
    }

    /* ====================================================================== */
    /* LIVE HIGHLIGHT CLIPS                                                   */
    /* ====================================================================== */

    match /clips/{clipId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.clippedByUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.hostId == request.auth.uid ||
        resource.data.clippedByUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount', 'updatedAt'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.hostId == request.auth.uid ||
          resource.data.clippedByUid == request.auth.uid
        )
      );
    }

    /* ====================================================================== */
    /* POSTS, STORIES, GROUPS, SPACES                                         */
    /* ====================================================================== */

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.author.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'reactions', 'likes', 'likesCount', 'commentsCount', 'sharesCount'])
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid
      );

      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == reactionId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.author.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.author.uid || isAdmin());
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorUid || isAdmin());
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.host.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.host.uid || isAdmin());
    }

    /* ====================================================================== */
    /* 4. SUPPORT TICKETS, REPORTS & APPEALS                                  */
    /* ====================================================================== */

    match /support_tickets/{ticketId} {
      // Any user (logged-in or public support visitor) can open a ticket; users can ONLY read their own
      allow create: if request.resource.data.status == 'OPEN' && (
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && (!('userId' in request.resource.data) || request.resource.data.userId == null || request.resource.data.userId == 'guest'))
      );
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }

    match /appeals/{appealId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* ====================================================================== */
    /* DIRECT MESSAGES (`conversations`)                                      */
    /* ====================================================================== */

    match /conversations/{conversationId} {
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids;
      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow update: if isSignedIn() && (
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.editedAt == request.time &&
            request.resource.data.deletedFor == resource.data.deletedFor &&
            request.resource.data.type == resource.data.type) ||
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
            request.resource.data.deletedFor.toSet() == resource.data.get('deletedFor', []).toSet().union([request.auth.uid].toSet()) &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.type == resource.data.type)
        );
      }
    }

    /* ====================================================================== */
    /* FINANCIAL LEDGER, WALLETS, PAYOUTS & PLATFORM CONFIG (SERVER-ONLY)     */
    /* ====================================================================== */

    match /admins/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'admin@lonkind.com' && request.auth.uid == userId);
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Admin SDK only — zero client writes
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /payoutRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /payout_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /payoutIdempotency/{keyId} {
      allow read, write: if false;
    }

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /wallet_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /ledger_journals/{journalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.actorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /ledger_entries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.accountId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /ledger_idempotency/{keyId} {
      allow read, write: if false;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /trending_hashtags/{tagId} {
      allow read: if true;
      allow write: if false;
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ad_campaigns/{campaignId} {
      allow read: if true;
      allow write: if false; // Admin SDK only (enforces atomic ad_spend & super_admin checks)

      match /unique_clicks/{viewerId} {
        allow read, write: if false;
      }

      match /view_windows/{windowId} {
        allow read, write: if false;
      }
    }

    match /ad_revenue_ledger/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ad_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ad_feedback/{feedbackId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ad_refund_idempotency/{refundId} {
      allow read, write: if false;
    }

    // Immutable Defense-in-Depth Security Audit Trail & Super-Admin 2FA
    match /security_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_2fa_challenges/{uid} {
      allow read, write: if false;
    }

    match /admin_2fa_sessions/{uid} {
      allow read, write: if false;
    }

    match /system_backups/{backupId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Strict 1-phone-per-account uniqueness registry & server-only hashed OTP store
    match /phone_registry/{e164Phone} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /otp_verifications/{uid} {
      allow read, write: if false;
    }

    // Zero client-side writes on dedicated wallet, coin transaction, and payout collections
    match /wallets/{walletId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (walletId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /coin_transactions/{txId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /payout_requests/{reqId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* ====================================================================== */
    /* DEFAULT DENY FALLBACK                                                  */
    /* ====================================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
