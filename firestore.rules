rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* ---------------- USERS ---------------- */

    match /users/{userId} {

      allow get, list: if isSignedIn();

      allow create: if isOwner(userId);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'diamonds', 'earningsNaira', 'heldEarningsNaira', 'lifetimeTipsReceived', 'lifetimeTipsGiven'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /friends/{friendId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friendRequests/{senderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);

        allow create: if isSignedIn() && request.auth.uid == senderId;

        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }

      match /following/{followingId} {
        allow read, write: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == followerId;
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /mutedUsers/{mutedId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    /* ---------------- POSTS ---------------- */

    match /posts/{postId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid ||
        // only allow safe system updates (comments/reactions only)
        request.resource.data.keys().hasAny(['comments', 'reactions'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.author.uid
      );

      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == reactionId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.author.uid;
      }
    }

    /* ---------------- STORIES ---------------- */

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        request.auth.uid == resource.data.authorUid;
    }

    /* ---------------- REPORTS ---------------- */

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, delete: if isAdmin();
    }

    /* ---------------- GROUPS ---------------- */

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    /* ---------------- SPACES ---------------- */

    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.host.uid;

      allow update: if isSignedIn();
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.host.uid;
    }

    /* ---------------- TRANSACTIONS (FIXED) ---------------- */

    match /transactions/{txId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- PAYOUTS ---------------- */

    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      allow create, update, delete: if false;
    }

    /* ---------------- GIFTS ---------------- */

    match /gifts/{giftId} {
      allow read: if true;

      allow create, update, delete: if false;
    }

    /* ---------------- CONVERSATIONS ---------------- */

    match /conversations/{conversationId} {

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids;

      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read, write: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }

    /* ---------------- ADMINS ---------------- */

    match /admins/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'admin@lonkind.com' && request.auth.uid == userId);
    }
  }
}