
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }

    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned', 'isProfessional']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) || request.resource.data.coins <= resource.data.coins) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['diamonds']) || request.resource.data.diamonds <= resource.data.diamonds)
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diamonds', 'lifetimeTipsReceived', 'badges'])
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /friends/{friendId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
      
      match /friendRequests/{senderId} {
        // userId is the one receiving, senderId is the one sending.
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderId);
        allow create: if request.auth != null && request.auth.uid == senderId;
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
      match /following/{followingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
      match /savedPosts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /blockedUsers/{blockedId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /mutedUsers/{mutedId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.author.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'reactions'])
      );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.author.uid || isAdmin());

      match /reactions/{reactionId} {
        allow read, write: if request.auth != null;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, list, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Let members join/leave
    }
    
    match /spaces/{spaceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.host.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.host.uid;
    }

    match /transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if true; // Let the backend create this
      allow update, delete: if false;
    }
    
    match /payouts/{payoutId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantUids;
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }
    
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
  }
}

    