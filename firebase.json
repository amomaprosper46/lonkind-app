{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "android/**",
      "android-wrapper/**",
      "_app-backup/**"
    ],
    "frameworksBackend": {
      "memory": "1GiB"
    }
  },
  "functions": {
    "source": "functions"
  }
}